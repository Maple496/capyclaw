{
  "$schema": "../../../../../packages/capyclaw-suite-kit/suite.schema.json",
  "name": "capyclaw-ppt-suite",
  "version": "2.4.10",
  "title": "PPT 工作台套件",
  "description": "PPTist 运行时（独立端口服务）+ 8 个独立 skill 包 + 4 个公共基建插件 + 文档工作台框架 + 底层 kit + 服务中间件（broker）与技能服务；2026-11-01 起按服务解耦标准：relay 不再 insert 进 dsh 进程，由中间件按清单以独立进程拉起。",
  "components": [
    "../../../../../packages/capyclaw-service-host",
    "../../../../../packages/capyclaw-tool-host",
    "../../../../../packages/capyclaw-asset-service",
    "../../../../../packages/capyclaw-editor-host"
  ],
  "packages": {
    "@capyclaw/plugin-kit": {
      "role": "support",
      "version": "^0.2.2",
      "path": "../../../../../packages/capyclaw-plugin-kit"
    },
    "@capyclaw/document-workbench": {
      "role": "support",
      "version": "^0.1.1",
      "path": "../../../../../packages/capyclaw-document-workbench"
    },
    "@capyclaw/ppt-workbench": {
      "role": "runtime",
      "version": "^2.4.4",
      "path": "../capyclaw-ppt-workbench",
      "requires": {
        "capabilities": {
          "host.http": "^1.0.0",
          "tools.registry": "^1.0.0",
          "assets.store": "^1.0.0",
          "editor.host": "^1.0.0"
        }
      },
      "provides": {
        "tools": [
          "ppt_*"
        ],
        "services": [
          "ppt-workbench"
        ],
        "ports": [
          39311
        ],
        "capabilities": {
          "ppt.runtime": "2.3.0",
          "ppt.tools": "2.3.0"
        }
      }
    },
    "@capyclaw/ppt-skill-ppt": {
      "role": "skills",
      "version": "^2.2.2",
      "path": "../capyclaw-ppt-skill-ppt",
      "requires": {
        "@capyclaw/ppt-workbench": "^2.2.0",
        "capabilities": {
          "ppt.runtime": "^2.2.0"
        }
      },
      "provides": {
        "skills": [
          "ppt"
        ],
        "capabilities": {
          "ppt.workflows": "2.2.0"
        }
      }
    },
    "@capyclaw/ppt-skill-narrative": {
      "role": "skills",
      "version": "^2.2.3",
      "path": "../capyclaw-ppt-skill-narrative",
      "requires": {
        "@capyclaw/ppt-workbench": "^2.2.0",
        "capabilities": {
          "ppt.runtime": "^2.2.0"
        }
      },
      "provides": {
        "skills": [
          "pptmaster-narrative"
        ],
        "capabilities": {
          "ppt.workflows": "2.2.0"
        }
      }
    },
    "@capyclaw/ppt-skill-design": {
      "role": "skills",
      "version": "^2.2.2",
      "path": "../capyclaw-ppt-skill-design",
      "requires": {
        "@capyclaw/ppt-workbench": "^2.2.0",
        "capabilities": {
          "ppt.runtime": "^2.2.0"
        }
      },
      "provides": {
        "skills": [
          "pptmaster-design"
        ],
        "capabilities": {
          "ppt.workflows": "2.2.0"
        }
      }
    },
    "@capyclaw/ppt-skill-api": {
      "role": "skills",
      "version": "^2.2.2",
      "path": "../capyclaw-ppt-skill-api",
      "requires": {
        "@capyclaw/ppt-workbench": "^2.2.0",
        "capabilities": {
          "ppt.runtime": "^2.2.0"
        }
      },
      "provides": {
        "skills": [
          "pptist-api"
        ],
        "capabilities": {
          "ppt.workflows": "2.2.0"
        }
      }
    },
    "@capyclaw/ppt-skill-authoring": {
      "role": "skills",
      "version": "^2.2.2",
      "path": "../capyclaw-ppt-skill-authoring",
      "requires": {
        "@capyclaw/ppt-workbench": "^2.2.0",
        "capabilities": {
          "ppt.runtime": "^2.2.0"
        }
      },
      "provides": {
        "skills": [
          "pptist-authoring"
        ],
        "capabilities": {
          "ppt.workflows": "2.2.0"
        }
      }
    },
    "@capyclaw/ppt-skill-editing": {
      "role": "skills",
      "version": "^2.2.2",
      "path": "../capyclaw-ppt-skill-editing",
      "requires": {
        "@capyclaw/ppt-workbench": "^2.2.0",
        "capabilities": {
          "ppt.runtime": "^2.2.0"
        }
      },
      "provides": {
        "skills": [
          "pptist-editing"
        ],
        "capabilities": {
          "ppt.workflows": "2.2.0"
        }
      }
    },
    "@capyclaw/ppt-skill-visual-check": {
      "role": "skills",
      "version": "^2.2.2",
      "path": "../capyclaw-ppt-skill-visual-check",
      "requires": {
        "@capyclaw/ppt-workbench": "^2.2.0",
        "capabilities": {
          "ppt.runtime": "^2.2.0"
        }
      },
      "provides": {
        "skills": [
          "pptist-visual-check"
        ],
        "capabilities": {
          "ppt.workflows": "2.2.0"
        }
      }
    },
    "@capyclaw/ppt-skill-research": {
      "role": "skills",
      "version": "^2.2.2",
      "path": "../capyclaw-ppt-skill-research",
      "requires": {
        "@capyclaw/ppt-workbench": "^2.2.0",
        "capabilities": {
          "ppt.runtime": "^2.2.0"
        }
      },
      "provides": {
        "skills": [
          "pptist-research"
        ],
        "capabilities": {
          "ppt.workflows": "2.2.0"
        }
      }
    },
    "@capyclaw/service-broker": {
      "role": "runtime",
      "version": "^0.2.4",
      "path": "../../../../../packages/capyclaw-service-broker",
      "provides": {
        "services": [
          "serviceBroker"
        ],
        "ports": [],
        "capabilities": {
          "service.broker": "1.0.0"
        }
      }
    },
    "@capyclaw/skills-service": {
      "role": "runtime",
      "version": "^0.1.4",
      "path": "../../capyclaw-skills-service",
      "provides": {
        "services": [
          "dsh-skills"
        ],
        "ports": [
          39321
        ],
        "capabilities": {
          "skills.http": "1.0.0"
        }
      }
    }
  },
  "rows": [
    {
      "id": "mcp-ppt",
      "name": "@deepseek-ai/dsh-mcp-client",
      "config": {
        "serverName": "ppt",
        "transport": "streamable-http",
        "url": "http://127.0.0.1:39311/mcp",
        "failOnStartupError": false,
        "toolCallTimeoutMs": 120000
      }
    },
    {
      "id": "ppt-skill-ppt",
      "name": "@capyclaw/ppt-skill-ppt"
    },
    {
      "id": "ppt-skill-narrative",
      "name": "@capyclaw/ppt-skill-narrative"
    },
    {
      "id": "ppt-skill-design",
      "name": "@capyclaw/ppt-skill-design"
    },
    {
      "id": "ppt-skill-api",
      "name": "@capyclaw/ppt-skill-api"
    },
    {
      "id": "ppt-skill-authoring",
      "name": "@capyclaw/ppt-skill-authoring"
    },
    {
      "id": "ppt-skill-editing",
      "name": "@capyclaw/ppt-skill-editing"
    },
    {
      "id": "ppt-skill-visual-check",
      "name": "@capyclaw/ppt-skill-visual-check"
    },
    {
      "id": "ppt-skill-research",
      "name": "@capyclaw/ppt-skill-research"
    }
  ],
  "checks": [
    {
      "id": "ppt-health",
      "type": "http",
      "url": "http://127.0.0.1:39311/healthz",
      "expectStatus": 200,
      "expectBody": {
        "ok": true,
        "contractsOk": true
      },
      "timeoutMs": 3000
    },
    {
      "id": "ppt-contract",
      "type": "contract",
      "url": "http://127.0.0.1:39311/mcp",
      "tool": "ppt_capabilities",
      "major": 2,
      "timeoutMs": 5000
    }
  ]
}
