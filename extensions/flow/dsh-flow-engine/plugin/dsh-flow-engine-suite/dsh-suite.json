{
  "name": "dsh-flow-engine-suite",
  "version": "1.0.0",
  "title": "dsh-flow-engine 套件",
  "description": "dsh-flow-engine DSH 插件",
  "packages": {
    "dsh-flow-engine": {
      "role": "runtime",
      "version": "^1.0.0",
      "path": "../dsh-flow-engine",
      "provides": {
        "tools": [
          "flow_engine_*"
        ],
        "services": [
          "flow-engine-service"
        ],
        "ports": [
          39600
        ],
        "capabilities": {
          "flow-engine.runtime": "1.0.0"
        }
      }
    }
  },
  "rows": [
    {
      "id": "dsh-flow-engine-host",
      "name": "dsh-flow-engine",
      "config": {
        "port": 39600
      }
    },
    {
      "id": "mcp-flow-engine",
      "name": "@deepseek-ai/dsh-mcp-client",
      "config": {
        "serverName": "flow-engine",
        "transport": "streamable-http",
        "url": "http://127.0.0.1:39600/mcp",
        "failOnStartupError": false,
        "toolCallTimeoutMs": 120000
      }
    }
  ],
  "checks": [
    {
      "id": "flow-engine-health",
      "type": "http",
      "url": "http://127.0.0.1:39600/healthz",
      "expectStatus": 200,
      "expectBody": {
        "ok": true
      },
      "timeoutMs": 3000
    },
    {
      "id": "flow-engine-contract",
      "type": "contract",
      "url": "http://127.0.0.1:39600/mcp",
      "tool": "flow_engine_capabilities",
      "major": 1,
      "timeoutMs": 5000
    }
  ]
}
