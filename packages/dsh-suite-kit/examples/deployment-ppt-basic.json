{
  "$schema": "../deployment.schema.json",
  "name": "ppt-basic",
  "version": "1.0.0",
  "title": "PPT 工作台 - 基础部署",
  "description": "标准 PPT 工作台部署：包含编辑器、18个工具、8个技能",
  
  "deployment": {
    "type": "domain",
    "source": "../../../extensions/bridges/ppt-bridge/domains/ppt",
    "autoStart": true,
    "autoRestart": false
  },

  "runtime": {
    "driver": "node",
    "workId": "main",
    "ports": {
      "harness": {
        "preferred": 3080,
        "range": 100
      },
      "content": {
        "preferred": 39311,
        "range": 100
      }
    },
    "model": {
      "id": "llm-deepseek",
      "plugin": "@deepseek-ai/dsh-llm-deepseek-api-key",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "baseURL": "https://api.deepseek.com/anthropic"
    }
  },

  "launcher": {
    "mode": "background",
    "logFile": "runtime.log",
    "healthCheck": {
      "enabled": true,
      "interval": 30,
      "timeout": 10,
      "retries": 3
    }
  },

  "metadata": {
    "environment": "production",
    "tags": ["ppt", "basic", "stable"],
    "notes": "标准生产环境部署，适合日常使用"
  }
}
