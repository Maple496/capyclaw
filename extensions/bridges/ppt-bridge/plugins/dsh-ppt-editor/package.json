{
  "name": "dsh-ppt-editor",
  "version": "1.0.0",
  "description": "PPT 编辑器 - AI 驱动的演示文稿创建和编辑工具，集成到 DeepSeek Harness 侧边栏",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./ui": "./ui/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "sidebar": {
      "enabled": true,
      "title": "PPT 编辑器",
      "icon": "📊",
      "position": "right",
      "width": 600
    }
  },
  "meta": {
    "title": "PPT 编辑器",
    "description": "AI 生成和编辑 PPT，实时预览效果"
  },
  "keywords": [
    "deepseek-harness",
    "plugin",
    "ppt",
    "presentation",
    "editor"
  ],
  "license": "MIT"
}
