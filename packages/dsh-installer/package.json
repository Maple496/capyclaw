{
  "name": "dsh-installer",
  "version": "0.1.0",
  "description": "安装器插件：解析/打包/安装 suite/domain，提供 ctx.installer 服务。",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "suite": "./dsh-suite.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "dsh-suite.json",
    "README.md"
  ],
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test test/unit.test.mjs"
  }
}
