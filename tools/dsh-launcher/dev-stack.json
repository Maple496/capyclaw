{
  "$schema": "../../packages/dsh-stack-kit/stack.schema.json",
  "_comment": "唯一编辑入口：插件 bundles / 服务 / 端口 / home / workspace 都在这里；profile package.json 与 dev-state/stack-services.json 是生成物。",
  "name": "dev",
  "home": "./.dshd/home",
  "profile": "web",
  "workspace": "../../../dsh-runtime/apps/harness/deepseek-harness/workspace",
  "stateDir": "./.dshd/dev-state",
  "ports": {
    "broker": 13593,
    "proxy": 13594,
    "upstream": 13595
  },
  "plugins": {
    "bundles": [
      "@deepseek-ai/dsh-base",
      "@deepseek-ai/dsh-web-app",
      {
        "name": "@capyclaw/launchpad",
        "path": "../../extensions/official/capyclaw-launchpad"
      },
      {
        "name": "dsh-ppt-workbench",
        "path": "../../extensions/bridges/ppt-bridge/plugin/dsh-ppt-workbench"
      },
      {
        "name": "@capyclaw/llm-tempkey",
        "path": "../../extensions/official/capyclaw-llm-tempkey"
      },
      {
        "name": "@capyclaw/ddr0-client",
        "path": "../../extensions/official/capyclaw-ddr0-client"
      }
    ],
    "install": true
  },
  "services": [
    {
      "id": "launchpad",
      "path": "../../extensions/official/capyclaw-launchpad/server.mjs",
      "args": [
        "--roots",
        "${STACK_DIR}/../..",
        "--dsh-home",
        "${home}",
        "--broker-url",
        "http://127.0.0.1:${ports.broker}"
      ],
      "ports": {
        "main": 13596
      },
      "healthPath": "/healthz",
      "keepAlive": true
    },
    {
      "id": "ppt-workbench",
      "path": "../../extensions/bridges/ppt-bridge/plugin/dsh-ppt-workbench/server/relay.mjs",
      "args": [
        "--port",
        "39311"
      ],
      "ports": {
        "main": 39311
      },
      "healthPath": "/healthz",
      "keepAlive": true
    }
  ]
}
