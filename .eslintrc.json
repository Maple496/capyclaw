{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-restricted-imports": ["error", {
      "patterns": [
        {
          "group": ["**/packages/*/src/**"],
          "message": "❌ 不要直接引用包的内部 src/ 路径，请使用公开 API（如 'dsh-suite-kit' 而非 '../packages/dsh-suite-kit/src/index.mjs'）"
        },
        {
          "group": ["../../../../packages/**", "../../../packages/**"],
          "message": "❌ 不要使用深层相对路径引用包，请使用包名（如 'dsh-plugin-kit' 而非 '../../../../packages/dsh-plugin-kit'）"
        },
        {
          "group": ["**/node_modules/**/src/**"],
          "message": "❌ 不要直接引用 node_modules 中包的内部路径"
        }
      ]
    }],
    "no-console": ["warn", { 
      "allow": ["warn", "error", "info"] 
    }],
    "no-unused-vars": ["error", { 
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_" 
    }]
  },
  "overrides": [
    {
      "files": ["**/*.test.mjs", "**/*.test.js", "**/test/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
