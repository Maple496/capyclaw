{
  "name": "demo",
  "version": "1.0.0",
  "title": "Demo 领域",
  "components": ["suite"],
  "baseBundles": ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-web-app"],
  "profile": { "name": "domain-demo", "port": 3080 },
  "runtime": {
    "driver": "node",
    "bindings": [
      { "row": "demo-host", "config": { "port": "${ports.content}" } }
    ],
    "ports": {
      "harness": { "preferred": 3080, "range": 100 },
      "content": { "preferred": 41001, "range": 100 }
    },
    "requires": {
      "tools": ["demo_*"],
      "services": ["demo-service"],
      "capabilities": ["demo.runtime@^1.0.0"]
    }
  },
  "removeRows": ["missing-row"]
}
