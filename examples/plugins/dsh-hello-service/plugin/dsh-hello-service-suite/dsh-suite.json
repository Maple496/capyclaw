{
  "name": "dsh-hello-service-suite",
  "version": "1.0.0",
  "title": "Hello Service 套件",
  "description": "Hello Service DSH 插件",
  "packages": {
    "dsh-hello-service": {
      "role": "runtime",
      "version": "^1.0.0",
      "path": "../dsh-hello-service",
      "provides": {
        "tools": [
          "hello_service_*"
        ],
        "services": [
          "hello-service-service"
        ],
        "ports": [
          39500
        ],
        "capabilities": {
          "hello-service.runtime": "1.0.0"
        }
      }
    }
  },
  "rows": [
    {
      "id": "dsh-hello-service-host",
      "name": "dsh-hello-service",
      "config": {
        "port": 39500
      }
    },
    {
      "id": "mcp-hello-service",
      "name": "@deepseek-ai/dsh-mcp-client",
      "config": {
        "serverName": "hello-service",
        "transport": "streamable-http",
        "url": "http://127.0.0.1:39500/mcp",
        "failOnStartupError": false,
        "toolCallTimeoutMs": 120000
      }
    }
  ],
  "checks": [
    {
      "id": "hello-service-health",
      "type": "http",
      "url": "http://127.0.0.1:39500/healthz",
      "expectStatus": 200,
      "expectBody": {
        "ok": true
      },
      "timeoutMs": 3000
    },
    {
      "id": "hello-service-contract",
      "type": "contract",
      "url": "http://127.0.0.1:39500/mcp",
      "tool": "hello_service_capabilities",
      "major": 1,
      "timeoutMs": 5000
    }
  ]
}
