{
  "name": "dsh-stack-kit",
  "version": "0.1.0",
  "description": "DSH 统一启动清单（dsh-stack.json）编译器：把插件 bundles、broker 服务、端口、profile/home/workspace 编译成现有运行时契约。",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./schema": "./stack.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "stack.schema.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/stack.test.mjs test/plugin-configs.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
