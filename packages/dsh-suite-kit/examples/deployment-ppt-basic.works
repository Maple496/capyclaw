%%%WORKS-META%%%
{
  "name": "PPT工作台部署配置",
  "brief": "标准PPT工作台部署：包含编辑器、18个工具、8个技能包",
  "tags": "部署,配置,PPT,DSH",
  "emoji": "🚀",
  "view": { "kind": "deployment" },
  "capabilities": ["deployment.dsh", "deployment.domain"],
  "requires": {
    "runtime": "dsh-suite-kit@>=1.0.0",
    "components": ["ppt-bridge/domains/ppt"]
  },
  "schema_version": "1.0.0"
}

%%%WORKS-CODE%%%
{
  "deployment": {
    "type": "domain",
    "source": "../../../extensions/bridges/ppt-bridge/domains/ppt",
    "autoStart": true,
    "autoRestart": false
  },
  
  "runtime": {
    "driver": "node",
    "workId": "main",
    "ports": {
      "harness": {
        "preferred": 3080,
        "range": 100
      },
      "content": {
        "preferred": 39311,
        "range": 100
      }
    },
    "model": {
      "id": "llm-deepseek",
      "plugin": "@deepseek-ai/dsh-llm-deepseek-api-key",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "baseURL": "https://api.deepseek.com/anthropic"
    },
    "env": {
      "NODE_ENV": "production"
    }
  },
  
  "launcher": {
    "mode": "background",
    "logFile": "runtime.log",
    "healthCheck": {
      "enabled": true,
      "interval": 30,
      "timeout": 10,
      "retries": 3
    },
    "beforeStart": [
      "echo 'Starting PPT Workbench...'"
    ],
    "afterStart": [
      "echo 'PPT Workbench started successfully'"
    ]
  },
  
  "metadata": {
    "owner": "system",
    "environment": "production",
    "tags": ["ppt", "stable", "v2"]
  }
}
