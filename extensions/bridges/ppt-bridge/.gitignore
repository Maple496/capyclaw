# 依赖
node_modules/

# 运行时单实例锁（插件运行/测试时生成）
plugin/dsh-ppt-workbench/server/.relay-instance.lock

# 构建输出（独立模式兜底目录）
dist/

# 本仓自持的 PPTist bundle（可选；运行真源在桌面仓 assets/）
assets/

