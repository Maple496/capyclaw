{
  "name": "deepseekharness-plugin-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "dsh 插件工程：构建 dsh 插件、生成打包产物、手动发布到 npm。不包含运行时编排与部署。",
  "scripts": {
    "build:plugin": "npm --prefix extensions/bridges/ppt-bridge run build:plugin",
    "check:plugin": "npm --prefix extensions/bridges/ppt-bridge run check:plugin",
    "create-plugin": "node tools/capyclaw-plugin-generator/bin/cli.mjs",
    "validate-plugin": "node tools/capyclaw-plugin-validator/bin/cli.mjs",
    "validate-all": "node scripts/validate-all-plugins.mjs",
    "release-plugin": "node tools/capyclaw-plugin-release/bin/cli.mjs release",
    "release-all": "node tools/capyclaw-plugin-release/bin/cli.mjs release --all",
    "release-index": "node tools/capyclaw-plugin-release/bin/cli.mjs index",
    "release-source": "node tools/capyclaw-plugin-release/bin/cli.mjs bundle",
    "verify-source": "node tools/capyclaw-plugin-release/bin/cli.mjs verify",
    "verify-publishable": "node scripts/verify-publishable.mjs",
    "gen-registry": "node scripts/gen-registry.mjs",
    "check-registry": "node scripts/gen-registry.mjs --check",
    "publish:npm": "node scripts/publish-to-npm.mjs",
    "publish:execute": "node scripts/publish-to-npm.mjs --execute"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "workspaces": [
    "packages/*",
    "extensions/official/*",
    "extensions/bridges/*",
    "tools/*"
  ]
}
