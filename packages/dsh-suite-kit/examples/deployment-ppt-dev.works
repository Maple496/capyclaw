%%%WORKS-META%%%
{
  "name": "PPT工作台-开发环境",
  "brief": "PPT工作台开发环境配置，包含调试和热更新",
  "tags": "部署,开发,PPT,DSH",
  "emoji": "🔧",
  "view": { "kind": "deployment" },
  "capabilities": ["deployment.dsh", "deployment.development"],
  "requires": {
    "runtime": "dsh-suite-kit@>=1.0.0",
    "components": ["WORKS-local-1793450417047"]
  },
  "schema_version": "1.0.0"
}

%%%WORKS-CODE%%%
{
  "deployment": {
    "type": "domain",
    "source": "../../../extensions/bridges/ppt-bridge/domains/ppt",
    "autoStart": true,
    "autoRestart": true
  },
  
  "runtime": {
    "driver": "node",
    "workId": "dev",
    "ports": {
      "harness": 3082,
      "content": 39312
    },
    "model": {
      "id": "llm-deepseek",
      "plugin": "@deepseek-ai/dsh-llm-deepseek-api-key",
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    },
    "env": {
      "NODE_ENV": "development",
      "DEBUG": "dsh:*"
    }
  },
  
  "launcher": {
    "mode": "foreground",
    "logFile": "dev.log",
    "healthCheck": {
      "enabled": true,
      "interval": 10,
      "timeout": 5,
      "retries": 1
    },
    "beforeStart": [
      "echo 'Starting development environment...'"
    ]
  },
  
  "metadata": {
    "environment": "development",
    "tags": ["ppt", "dev", "debug"]
  }
}
