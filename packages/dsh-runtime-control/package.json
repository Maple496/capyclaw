{
  "name": "dsh-runtime-control",
  "version": "0.1.0",
  "description": "控制面插件：提供 runtimeControl 服务，管理 worker runtime 的创建、启动、停止、doctor 和清理。",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "suite": "./dsh-suite.json"
  },
  "files": ["lib/", "cordis.patch.yml", "dsh-suite.json", "README.md"],
  "scripts": { "test": "node --test test/e2e.test.mjs" },
  "private": true,
  "license": "MIT"
}
