{
  "$schema": "../deployment.schema.json",
  "name": "multi-service",
  "version": "1.0.0",
  "title": "多服务组合部署",
  "description": "同时部署 PPT + Canvas 多个服务",
  
  "deployment": {
    "type": "custom",
    "source": "./multi-service-manifest.json",
    "autoStart": true,
    "autoRestart": false
  },

  "runtime": {
    "driver": "node",
    "workId": "main",
    "ports": {
      "harness": {
        "preferred": 3090,
        "range": 100
      },
      "content": {
        "preferred": 39400,
        "range": 100
      }
    }
  },

  "launcher": {
    "mode": "background",
    "healthCheck": {
      "enabled": true,
      "interval": 30,
      "timeout": 10,
      "retries": 3
    },
    "beforeStart": [
      "echo 'Checking prerequisites...'",
      "node scripts/check-deps.mjs"
    ],
    "afterStart": [
      "echo 'Services started successfully'",
      "node scripts/notify-ready.mjs"
    ]
  },

  "monitoring": {
    "enabled": true,
    "metricsPort": 9090,
    "alerts": {
      "cpuThreshold": 80,
      "memoryThreshold": 85,
      "diskThreshold": 90
    }
  },

  "metadata": {
    "environment": "production",
    "tags": ["multi-service", "ppt", "canvas"],
    "owner": "admin",
    "notes": "生产环境多服务部署，包含监控和告警"
  }
}
