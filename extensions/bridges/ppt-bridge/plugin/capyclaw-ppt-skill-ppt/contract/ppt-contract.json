    {
      "name": "ppt_image",
      "kind": "write",
      "since": "1.0.0",
      "capability": "image",
      "description": "插入图片（一次完成，图片先写入对象仓库，deck 只存 /assets/<sha256> 引用）：attachment_id 取聊天图片附件的 sha256 id；也支持 path/src。src 走远程下载时带浏览器头、25s 超时、自动重试一次，上限 6MB。失败会返回 [错误码]：HOST_BLOCKED / HTTP_403 / TIMEOUT / TOO_LARGE 等——永久性失败不要重试同一链接或域名，改换来源或先用本地 path 下载。不要用 shell 找图，不要截图验证。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slide": {
            "type": "integer",
            "description": "0 起页号，缺省 0（封面）"
          },
          "attachment_id": {
            "type": "string",
            "description": "聊天图片附件的 attachmentId（sha256:…）"
          },
          "attachmentId": {
            "type": "string",
            "description": "attachment_id 的兼容别名"
          },
          "path": {
            "type": "string",
            "description": "本机图片路径（兼容旧用法）"
          },
          "src": {
            "type": "string",
            "description": "http(s) 或 data URL"
          },
          "left": {
            "type": "number"
          },
          "top": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
