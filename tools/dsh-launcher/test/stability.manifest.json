{
  "_comment": "稳定性验证用开机清单：隔离端口(auto)+隔离数据目录，绝不触碰 39311/39312 生产实例。cmd 指向本仓库 extensions/bridges/ppt-bridge 内的服务副本（不再依赖桌面前端投递包）。",
  "services": [
    {
      "id": "ppt-workbench-stab",
      "cmd": [
        "node",
        "${PACKAGE_DIR}/../../../extensions/bridges/ppt-bridge/plugin/dsh-ppt-workbench/server/relay.mjs",
        "--port",
        "${PORT}",
        "--dir",
        "${PACKAGE_DIR}/../.dshd-test/ppt-host"
      ],
      "ports": { "main": "auto" },
      "url": "http://127.0.0.1:${PORT}/",
      "keepAlive": true
    },
    {
      "id": "dsh-skills-stab",
      "cmd": [
        "node",
        "${PACKAGE_DIR}/../../../extensions/bridges/ppt-bridge/dsh-skills-service/server.mjs",
        "--port",
        "${PORT}"
      ],
      "ports": { "main": "auto" },
      "url": "http://127.0.0.1:${PORT}",
      "keepAlive": true
    }
  ]
}
