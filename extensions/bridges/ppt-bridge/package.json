{
  "name": "ppt-bridge-middleware",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Keynote/PPTist 工作台中间件：桥契约、studio 核心逻辑、MCP 工具服务、插件包构建与 skill 源",
  "scripts": {
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:plugin": "node scripts/build-plugin.mjs --check",
    "lint:skills": "node scripts/lint-skills.mjs",
    "suite:validate": "node ../../../packages/dsh-suite-kit/bin/dsh-suite.mjs validate plugin/capyclaw-ppt-suite",
    "suite:compose": "node ../../../packages/dsh-suite-kit/bin/dsh-suite.mjs compose plugin/capyclaw-ppt-suite --out dist/suite"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0"
  }
}
