{
  "_comment": "deployment-multi-service.json 的 source 所指 fixture：PPT 工作台 + hello 服务两服务组合。cmd 用 ${STACK_DIR} 相对展开由消费者解析；这里是示例数据，路径相对本文件。",
  "services": [
    {
      "id": "ppt-workbench",
      "cmd": [
        "node",
        "../../../extensions/bridges/ppt-bridge/plugin/capyclaw-ppt-workbench/server/relay.mjs",
        "--port",
        "${PORT}"
      ],
      "env": {},
      "ports": {
        "main": 39311
      },
      "url": "http://127.0.0.1:${PORT}",
      "healthPath": "/healthz",
      "keepAlive": true
    },
    {
      "id": "dsh-hello-service",
      "cmd": [
        "node",
        "../../../examples/plugins/dsh-hello-service/plugin/dsh-hello-service/server/relay.mjs",
        "--port",
        "${PORT}"
      ],
      "env": {},
      "ports": {
        "main": 39500
      },
      "url": "http://127.0.0.1:${PORT}",
      "healthPath": "/healthz",
      "keepAlive": true
    }
  ]
}
