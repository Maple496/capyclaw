{
  "name": "@capyclaw/service-host",
  "version": "0.1.1",
  "description": "DSH 公共服务宿主插件：统一 HTTP 路由、健康检查、指标、单实例锁、端口复用与静态资源，向插件提供 ctx.serviceHost。",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./src": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18",
    "dsh": "^0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "suite": "./dsh-suite.json",
    "category": "service",
    "platform": "both",
    "apiVersion": "1.0.0"
  },
  "meta": {
    "title": "公共服务宿主",
    "description": "统一 HTTP 路由、健康检查、指标、单实例锁与端口复用，向插件提供 ctx.serviceHost"
  },
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml",
    "dsh-suite.json",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "@capyclaw/plugin-kit": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maple496/capyclaw.git",
    "directory": "packages/capyclaw-service-host"
  },
  "bugs": {
    "url": "https://github.com/Maple496/capyclaw/issues"
  },
  "homepage": "https://github.com/Maple496/capyclaw/tree/main/packages/capyclaw-service-host#readme"
}
