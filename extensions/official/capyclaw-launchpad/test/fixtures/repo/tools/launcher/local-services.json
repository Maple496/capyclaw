{
  "services": [
    {
      "id": "alpha",
      "cmd": ["node", "${PACKAGE_DIR}/server.mjs", "--port", "${PORT}"],
      "ports": { "main": "auto" },
      "url": "http://127.0.0.1:${PORT}",
      "keepAlive": true
    },
    {
      "id": "beta",
      "cmd": ["node", "${PACKAGE_DIR}/missing.mjs"],
      "ports": { "main": 41001 },
      "url": "http://127.0.0.1:41001",
      "requires": ["alpha"]
    },
    {
      "id": "gamma",
      "cmd": ["node", "${PACKAGE_DIR}/server.mjs"],
      "ports": { "main": 41001 },
      "url": "http://127.0.0.1:41001",
      "requires": ["delta"]
    },
    {
      "id": "dirsvc",
      "cmd": ["node", "${PACKAGE_DIR}/server.mjs", "--dir", "${PACKAGE_DIR}/missing-dir"],
      "env": { "API_KEY": "s3cr3t" },
      "ports": { "main": 41002 },
      "url": "http://127.0.0.1:41002"
    }
  ]
}
