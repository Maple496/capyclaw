{
  "name": "dsh-llm-config-suite",
  "version": "1.0.0",
  "title": "LLM Config Manager 套件",
  "description": "LLM Config Manager DSH 插件",
  "packages": {
    "dsh-llm-config": {
      "role": "runtime",
      "version": "^1.0.0",
      "path": "../dsh-llm-config",
      "provides": {
        "tools": [
          "llm_config_*"
        ],
        "services": [
          "llm-config-service"
        ],
        "ports": [
          39600
        ],
        "capabilities": {
          "llm-config.runtime": "1.0.0"
        }
      }
    }
  },
  "rows": [
    {
      "id": "dsh-llm-config-host",
      "name": "dsh-llm-config",
      "config": {
        "port": 39600
      }
    },
    {
      "id": "mcp-llm-config",
      "name": "@deepseek-ai/dsh-mcp-client",
      "config": {
        "serverName": "llm-config",
        "transport": "streamable-http",
        "url": "http://127.0.0.1:39600/mcp",
        "failOnStartupError": false,
        "toolCallTimeoutMs": 120000
      }
    }
  ],
  "checks": [
    {
      "id": "llm-config-health",
      "type": "http",
      "url": "http://127.0.0.1:39600/healthz",
      "expectStatus": 200,
      "expectBody": {
        "ok": true
      },
      "timeoutMs": 3000
    },
    {
      "id": "llm-config-contract",
      "type": "contract",
      "url": "http://127.0.0.1:39600/mcp",
      "tool": "llm_config_capabilities",
      "major": 1,
      "timeoutMs": 5000
    }
  ]
}
