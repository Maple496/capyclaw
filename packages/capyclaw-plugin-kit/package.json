    "directory": "packages/capyclaw-plugin-kit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin-sdk"
  ],
  "bugs": {
    "url": "https://github.com/Maple496/capyclaw/issues"
