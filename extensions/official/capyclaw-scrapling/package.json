{
  "name": "@capyclaw/scrapling",
  "version": "1.1.0",
  "description": "Scrapling 网页抓取集成：HTTP 抓取 + 纯 Node CSS 选择器提取 + 可视化爬虫工作台（浏览器打开即用）",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./api": "./lib/index.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@capyclaw/plugin-kit": "^0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    },
    "category": "tool",
    "platform": "both"
  },
  "meta": {
    "title": "Scrapling 网页抓取",
    "description": "网页数据爬取工具：HTTP 抓取、CSS 选择器提取（::text/::attr，纯 Node 实现）、可视化爬虫工作台（http://127.0.0.1:39640/，步骤回放 + 选择器试玩 + JSON/CSV 导出，内置离线演示页）。浏览器渲染与 XPath 依赖外部 Python scrapling，未实现并如实标注。"
  },
  "files": [
    "lib/",
    "client/",
    "server/",
    "ui/",
    "demo/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "start": "node server/server.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=18",
    "dsh": "^0.2.0-rc.2"
  },
  "license": "MIT",
  "author": {
    "name": "CapyClaw",
    "url": "https://github.com/capyclaw",
    "email": "support@capyclaw.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maple496/capyclaw.git",
    "directory": "extensions/official/capyclaw-scrapling"
  },
  "bugs": {
    "url": "https://github.com/Maple496/capyclaw/issues"
  },
  "homepage": "https://github.com/capyclaw/dsh-plugins",
  "publishConfig": {
    "access": "public"
  }
}
