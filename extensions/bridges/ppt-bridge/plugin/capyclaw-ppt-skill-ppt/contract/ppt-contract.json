          "header": {
            "type": "boolean",
            "description": "首行作为表头（加粗 + 主题色浅底）"
          },
          "theme_color": {
            "type": "string",
            "description": "表格主题色（表头底色由此淡化生成），默认 #5b9bd5"
          },
          "element_id": {
            "type": "string",
            "description": "更新模式：整体替换该表格的数据/列宽"
          },
          "col_widths": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "列宽比例或像素（自动归一）"
          },
          "cell_min_height": {
            "type": "number",
            "description": "单元格最小高度，默认 36"
          },
          "left": {
            "type": "number"
          },
          "top": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        },
        "required": [
          "slide",
          "rows"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ppt_table_cells",
      "kind": "write",
      "since": "2.2.0",
      "capability": "table",
      "description": "精修已有表格的单元格：改文字 / 加粗 / 颜色 / 底色 / 对齐 / 字号，也可换表格主题色。行号列号从 0 起，元素 id 可用 ppt_get_deck 查询。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slide": {
            "type": "integer",
            "description": "0 起页号，默认 0"
          },
          "element_id": {
            "type": "string",
            "description": "表格元素 id"
          },
          "cells": {
            "type": "array",
            "description": "单元格补丁列表",
            "items": {
              "type": "object",
              "properties": {
                "row": {
                  "type": "integer",
                  "description": "0 起行号"
                },
                "col": {
                  "type": "integer",
                  "description": "0 起列号"
                },
                "text": {
                  "type": "string"
                },
                "bold": {
                  "type": "boolean"
                },
                "color": {
                  "type": "string",
                  "description": "文字颜色"
                },
                "backcolor": {
                  "type": "string",
                  "description": "单元格底色"
                },
                "align": {
                  "type": "string",
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "fontsize": {
                  "type": "number"
                }
              },
              "required": [
                "row",
                "col"
              ],
              "additionalProperties": false
            }
          },
          "theme_color": {
            "type": "string",
            "description": "顺带更换表格主题色"
          }
        },
        "required": [
          "slide",
          "element_id",
          "cells"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ppt_notes",
      "kind": "write",
      "since": "2.2.0",
      "capability": "notes",
      "description": "设置指定页的演讲者备注（显示在编辑器备注面板，导出 PPTX 一并保留）。传空字符串清空。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slide": {
            "type": "integer",
            "description": "0 起页号"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "description": "备注内容；空字符串清空"
          }
        },
        "required": [
          "slide",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ppt_shape",
      "kind": "write",
      "since": "2.2.0",
      "capability": "shape",
      "description": "插入形状。shape 从内置库选（rect / round-rect / circle / triangle / triangle-down / diamond / pentagon / hexagon / star-5 / arrow-right / arrow-left / arrow-up / arrow-down / double-arrow / bubble / heart / cloud / bolt / cross / pie-quarter / cylinder / round-frame），也可传自定义 SVG path + viewBox。装饰、流程节点、强调块都走这里。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slide": {
            "type": "integer",
            "description": "0 起页号，默认 0"
          },
          "shape": {
            "type": "string",
            "description": "内置形状 key，如 circle / arrow-right / star-5 / round-rect"
          },
          "path": {
            "type": "string",
            "description": "自定义 SVG path（与 shape 二选一，优先生效）"
          },
          "viewBox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "自定义 path 的 viewBox [w, h]，默认 [200, 200]"
          },
          "fill": {
            "type": "string",
            "description": "填充色，默认 #5b9bd5"
          },
          "left": {
            "type": "number"
          },
          "top": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "description": "默认 200"
          },
          "height": {
            "type": "number",
            "description": "默认 200"
          },
          "rotate": {
            "type": "number"
          }
        },
        "required": [
          "slide"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ppt_line",
      "kind": "write",
      "since": "2.2.0",
      "capability": "line",
      "description": "画一条线（直线 / 虚线 / 折线）。给起点终点画布坐标即可，包围盒自动计算；端点箭头可选 arrow / triangle / dot / square；broken 给拐点画布坐标可画折线。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slide": {
            "type": "integer",
            "description": "0 起页号，默认 0"
          },
          "x1": {
            "type": "number",
            "description": "起点 x（画布坐标）"
          },
          "y1": {
            "type": "number",
            "description": "起点 y"
          },
          "x2": {
            "type": "number",
            "description": "终点 x"
          },
          "y2": {
            "type": "number",
            "description": "终点 y"
          },
          "color": {
            "type": "string",
            "description": "线色，默认 #5b9bd5"
          },
          "style": {
            "type": "string",
            "enum": [
              "solid",
              "dashed"
            ],
            "description": "默认 solid"
          },
          "width": {
            "type": "number",
            "description": "线宽，默认 2"
          },
          "start_point": {
            "type": "string",
            "enum": [
              "none",
              "arrow",
              "triangle",
              "dot",
              "square"
            ],
            "description": "起点箭头，默认 none"
          },
          "end_point": {
            "type": "string",
            "enum": [
              "none",
              "arrow",
              "triangle",
              "dot",
              "square"
            ],
            "description": "终点箭头，默认 none"
          },
          "broken": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "折线拐点 [x, y]（画布坐标，产生 ┳ 型连接）"
          }
        },
        "required": [
          "slide",
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ppt_formula",
      "kind": "write",
      "since": "2.2.0",
      "capability": "formula",
      "description": "插入或更新数学公式（TeX 语法，PPTist 原生 latex 元素，手写风描边渲染）。支持分式 \\frac{}{}、上下标 ^ _、根号 \\sqrt、求和积分 \\sum \\int、希腊字母、矩阵等；渲染由内置 hfmath 引擎完成。带 element_id 时为更新（重新渲染并替换）。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slide": {
            "type": "integer",
            "description": "0 起页号，默认 0"
          },
          "latex": {
            "type": "string",
            "description": "TeX 公式，如 E=mc^2 / \\frac{a}{b} / \\int_0^1 x^2 dx"
          },
          "element_id": {
            "type": "string",
            "description": "更新模式：要更新的公式元素 id"
          },
          "color": {
            "type": "string",
            "description": "笔画颜色，默认 #333333"
          },
          "stroke_width": {
            "type": "number",
            "description": "笔画宽度，默认 2"
          },
          "left": {
            "type": "number"
          },
          "top": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "description": "默认按渲染原始尺寸"
          },
          "height": {
            "type": "number",
            "description": "默认按渲染原始尺寸（fixedRatio 锁比例）"
          }
        },
        "required": [
          "slide",
          "latex"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ppt_import_pptx",
      "kind": "write",
      "since": "2.4.0",
      "capability": "import",
      "description": "打开本机 .pptx：上传给右侧 PPTist 编辑器，用其原生导入器转换成可编辑 deck。导入后返回标题/页数/每页元素摘要；动画、母版、SmartArt、复杂图表等可能丢失。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "本机 .pptx 文件路径（绝对路径，或相对 MCP 进程 cwd）"
          },
          "data": {
            "type": "string",
            "description": "可选：PPTX 的 base64 内容（无法访问 path 时使用）"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "description": "显示文件名；缺省取 path 的 basename"
          },
          "mode": {
            "type": "string",
            "enum": [
              "replace",
              "append"
            ],
            "description": "replace（默认）用导入内容替换当前 deck；append 追加到现有页之后"
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 300000,
            "description": "等待编辑器完成导入的毫秒数（默认 180000）"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "ppt_export_pptx",
      "kind": "write",
      "since": "2.4.0",
      "capability": "export",
      "description": "把当前 deck 导出为本机 .pptx 文件（pptxgenjs）。支持文字/形状/图片/线条/表格/图表/背景/备注；自定义 SVG 路径用矩形近似，LaTeX/音视频跳过。返回文件绝对路径与降级项。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "输出 .pptx 路径，或已存在的目录；缺省写到系统临时目录 ppt-exports/"
          },
          "file_name": {
            "type": "string",
            "maxLength": 160,
            "description": "文件名（可省略 .pptx）；path 为目录/缺省时使用"
          },
          "slide_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "maxItems": 200,
            "description": "只导出指定页（0 基）；缺省导出全部"
          },
          "include_notes": {
            "type": "boolean",
            "description": "是否写入演讲者备注（默认 true）"
          },
          "overwrite": {
            "type": "boolean",
            "description": "目标已存在时是否覆盖；保存回原文件必须显式 true"
          },
          "backup": {
            "type": "boolean",
            "description": "覆盖前是否备份为 <name>.bak-<时间>.pptx（默认 true）"
          }
        },
        "additionalProperties": false
      }
    }
  ],
