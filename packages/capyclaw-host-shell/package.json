    "./process-manager": "./src/process-manager.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-host": "./bin/dsh-host.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
