{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/product.schema.json",
  "title": "DSH Product Manifest",
  "description": "产品清单：选择组件，生成能力注册表或 suite bundle。",
  "type": "object",
  "required": ["name", "version", "target"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "产品名（kebab-case）"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "description": "产品版本"
    },
    "title": {
      "type": "string",
      "description": "显示标题"
    },
    "description": {
      "type": "string",
      "description": "产品描述"
    },
    "target": {
      "type": "string",
      "enum": ["registry", "bundle"],
      "description": "目标产物类型：registry=能力注册表，bundle=suite"
    },
    "select": {
      "type": "object",
      "description": "选择的组件",
      "properties": {
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "capability 组件 id 列表"
        },
        "packages": {
          "type": "array",
          "items": { "type": "string" },
          "description": "plugin 包名列表"
        },
        "all": {
          "type": "boolean",
          "description": "选择所有可用组件"
        }
      }
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string" },
      "description": "排除的组件 id"
    },
    "registry": {
      "type": "object",
      "description": "registry target 的额外配置",
      "properties": {
        "loaderPath": {
          "type": "string",
          "description": "生成的 loader 文件相对路径（默认 capabilities.loader.mjs）"
        },
        "manifestPath": {
          "type": "string",
          "description": "生成的 manifest 文件相对路径（默认 capabilities.manifest.json）"
        },
        "baseUrl": {
          "type": "string",
          "description": "模块路径解析的 base URL（默认 ./）"
        }
      }
    },
    "bundle": {
      "type": "object",
      "description": "bundle target 的额外配置",
      "properties": {
        "suiteName": {
          "type": "string",
          "description": "生成的 suite 名称（默认 <name>-suite）"
        },
        "rows": {
          "type": "array",
          "description": "额外的 cordis rows",
          "items": { "type": "object" }
        },
        "checks": {
          "type": "array",
          "description": "额外的健康检查",
          "items": { "type": "object" }
        }
      }
    }
  }
}
