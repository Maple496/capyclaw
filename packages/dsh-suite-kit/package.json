{
  "name": "dsh-suite-kit",
  "version": "0.1.0",
  "description": "DSH suite/domain 清单校验与组合工具：manifest 校验、compose、profile 生成、domain 解析。",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./domain": "./src/domain.mjs",
    "./compose": "./src/compose.mjs",
    "./manifest": "./src/manifest.mjs",
    "./profile": "./src/profile.mjs",
    "./artifacts": "./src/artifacts.mjs",
    "./schema": "./suite.schema.json",
    "./package.json": "./package.json",
    "./domain-schema": "./domain.schema.json"
  },
  "bin": {
    "dsh-suite": "./bin/dsh-suite.mjs",
    "dsh-domain": "./bin/dsh-domain.mjs"
  },
  "files": [
    "README.md",
    "bin/",
    "domain.schema.json",
    "src/",
    "suite.schema.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true
}
