{
  "$schema": "../dsh-suite-kit/suite.schema.json",
  "name": "dsh-mcp-gateway-suite",
  "version": "0.1.0",
  "title": "MCP Gateway",
  "description": "把多个插件的 MCP 工具面聚合成一个外部端点。",
  "components": [
    "../dsh-service-host",
    "../dsh-tool-host"
  ],
  "packages": {
    "dsh-plugin-kit": {
      "role": "support",
      "version": "^0.2.0",
      "path": "../dsh-plugin-kit"
    },
    "dsh-mcp-gateway": {
      "role": "provider",
      "version": "^0.1.0",
      "path": ".",
      "provides": {
        "services": ["mcpGateway"],
        "capabilities": {
          "mcp.gateway": "1.0.0"
        }
      }
    }
  },
  "rows": [
    {
      "id": "mcp-gateway",
      "name": "dsh-mcp-gateway"
    }
  ],
  "checks": []
}
