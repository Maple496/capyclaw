# example — 一个可点击启动的最小 dsh 模式（自动端口）
# 插件只有 dsh-base + dsh-web-app，不启动独立服务；用于演示“点一下拉起一套 dsh”。
stack "example" {
  kind "profile"
  home "../.dshd/launchpads/example/home"
  profile "web"
  workspace "../.dshd/launchpads/example/workspace"
  stateDir "../.dshd/launchpads/example/state"

  ports {
    broker "auto"
    proxy "auto"
    upstream "auto"
  }

  plugins {
    bundle "@deepseek-ai/dsh-base"
    bundle "@deepseek-ai/dsh-web-app"
  }
}
