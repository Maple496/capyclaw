{
  "name": "@capyclaw/asset-service",
  "version": "0.1.1",
  "description": "DSH 公共资产插件：sha256 对象仓库、/assets 路由、base64 上传与 content-type，向插件提供 ctx.assets。",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./src": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18",
    "dsh": "^0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "suite": "./dsh-suite.json",
    "apiVersion": "1.0.0",
    "category": "service",
    "platform": "both"
  },
  "meta": {
    "title": "公共资产服务",
    "description": "sha256 对象仓库、/assets 路由、base64 上传与 content-type，向插件提供 ctx.assets"
  },
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml",
    "dsh-suite.json",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {},
  "dependencies": {
    "@capyclaw/plugin-kit": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maple496/capyclaw.git",
    "directory": "packages/capyclaw-asset-service"
  },
  "bugs": {
    "url": "https://github.com/Maple496/capyclaw/issues"
  },
  "homepage": "https://github.com/Maple496/capyclaw/tree/main/packages/capyclaw-asset-service#readme"
}
