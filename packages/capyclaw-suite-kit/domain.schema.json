{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/domain.schema.json",
  "title": "DSH Domain Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "components"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "baseBundles": { "type": "array", "items": { "type": "string" } },
    "components": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "port": { "type": "integer" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "driver": { "type": "string", "enum": ["node", "jobobject", "docker", "wsl"] },
        "workId": { "type": "string" },
        "ttlSec": { "type": "integer", "minimum": 0 },
        "env": { "type": "object", "additionalProperties": true },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "row": { "type": "string" },
              "package": { "type": "string" },
              "port": { "type": "string" },
              "config": { "type": "object" }
            }
          }
        },
        "urlPort": { "type": "string" },
        "model": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "id": { "type": "string" },
                "plugin": { "type": "string" },
                "apiKeyEnv": { "type": "string" },
                "baseUrlEnv": { "type": "string" },
                "baseURL": { "type": "string" }
              }
            }
          ]
        },
        "workspaceController": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "object", "additionalProperties": true }
          ]
        },
        "requires": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "tools": { "type": "array", "items": { "type": "string" } },
            "services": { "type": "array", "items": { "type": "string" } },
            "capabilities": { "type": "array", "items": { "type": "string" } }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "sessions": { "type": "object" },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "id": { "type": "string" },
                  "kind": { "type": "string" },
                  "path": { "type": "string" },
                  "patterns": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "workspace": { "type": "object" },
            "network": { "type": "object" },
            "processes": { "type": "object" }
          }
        },
        "ports": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "harness": { "oneOf": [{ "type": "integer" }, { "type": "object" }] },
            "dsh": { "oneOf": [{ "type": "integer" }, { "type": "object" }] },
            "content": { "oneOf": [{ "type": "integer" }, { "type": "object" }] },
            "services": {
              "type": "object",
              "additionalProperties": { "oneOf": [{ "type": "integer" }, { "type": "object" }] }
            }
          }
        }
      }
    },
    "removeRows": { "type": "array", "items": { "type": "string" } },
    "removeDependencies": { "type": "array", "items": { "type": "string" } },
    "rowOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "config": { "type": "object" },
          "disabled": { "type": "boolean" }
        }
      }
    }
  }
}
