{
  "name": "@capyclaw/canvas-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Canvas 文档工作台中间件：桥契约、块级写作核心、MCP 工具服务、插件包构建与 skill 源；standalone 形态保留 headless 调试路径",
  "scripts": {
    "discover": "node scripts/discover-api.mjs --out contract/canvas-api.json",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:plugin": "node scripts/build-plugin.mjs --check",
    "lint:skills": "node scripts/lint-skills.mjs",
    "suite:validate": "node ../../../packages/capyclaw-suite-kit/bin/dsh-suite.mjs validate plugin/capyclaw-canvas-suite",
    "suite:compose": "node ../../../packages/capyclaw-suite-kit/bin/dsh-suite.mjs compose plugin/capyclaw-canvas-suite --out dist/suite",
    "start:workbench": "node plugin/capyclaw-canvas-workbench/server/relay.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node scripts/e2e-verify.mjs",
    "start:standalone": "node standalone/server.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "dependencies": {
    "playwright": "^1.40.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maple496/capyclaw.git",
    "directory": "extensions/bridges/canvas-bridge"
  },
  "bugs": {
    "url": "https://github.com/Maple496/capyclaw/issues"
  },
  "homepage": "https://github.com/Maple496/capyclaw/tree/main/extensions/bridges/canvas-bridge#readme"
}
