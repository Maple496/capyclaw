{
  "name": "dsh-assembly-kit",
  "version": "0.1.0",
  "description": "DSH 统一组合系统：组件库扫描、依赖解析、产物生成（能力注册表 / suite manifest）。",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./component-schema": "./component.schema.json",
    "./product-schema": "./product.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-assembly": "./bin/dsh-assembly.mjs"
  },
  "files": [
    "README.md",
    "bin/",
    "component.schema.json",
    "product.schema.json",
    "src/"
  ],
  "scripts": {
    "test": "node --test test/scanner.test.mjs test/resolver.test.mjs test/emitter.test.mjs test/catalog.test.mjs"
  },
  "dependencies": {
    "dsh-suite-kit": "^0.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true
}
