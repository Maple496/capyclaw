{
  "name": "@capyclaw/editor-host",
  "version": "0.1.2",
  "description": "DSH 公共编辑器宿主插件：静态托管、租约仲裁、心跳与连接状态，向插件提供 ctx.editorHost。",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./src": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18",
    "dsh": "^0.2.0-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "suite": "./dsh-suite.json",
    "apiVersion": "1.0.0",
    "category": "service",
    "platform": "both"
  },
  "meta": {
    "title": "公共编辑器宿主",
    "description": "静态托管、租约仲裁、心跳与连接状态，向插件提供 ctx.editorHost"
  },
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml",
    "dsh-suite.json",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {},
  "dependencies": {
    "@capyclaw/plugin-kit": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maple496/capyclaw.git",
    "directory": "packages/capyclaw-editor-host"
  },
  "bugs": {
    "url": "https://github.com/Maple496/capyclaw/issues"
  },
  "homepage": "https://github.com/Maple496/capyclaw/tree/main/packages/capyclaw-editor-host#readme"
}
