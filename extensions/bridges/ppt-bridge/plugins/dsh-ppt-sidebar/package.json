{
  "name": "dsh-ppt-sidebar",
  "version": "1.0.0",
  "description": "PPT 工作台 - 侧边栏集成版本，支持实时预览和 AI 交互",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "sidebar": {
      "enabled": true,
      "title": "PPT 工作台",
      "icon": "📊",
      "url": "http://127.0.0.1:39311",
      "websocket": "ws://127.0.0.1:39311/ws",
      "width": 600,
      "minWidth": 400,
      "maxWidth": 800,
      "position": "right"
    }
  },
  "meta": {
    "title": "PPT 工作台",
    "description": "AI 生成 PPT + 实时预览 + 低延迟交互"
  },
  "files": [
    "lib/",
    "server/",
    "ui/",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": ["deepseek-harness", "plugin", "ppt", "sidebar"],
  "license": "MIT"
}
