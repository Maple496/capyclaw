  "description": "DDH 千帆临时 Key 分发客户端：校验主站登录态 → 签发临时 LLM Key（计费预扣积分）→ 到期前自动轮换 → 通过凭据缝注入 dsh 的 pi-ai 路由。",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@capyclaw/plugin-kit": "^0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "category": "service",
    "platform": "both"
  },
  "engines": {
    "dsh": "^0.2.0-rc.2",
    "node": ">=18"
  },
  "meta": {
    "title": "LLM 临时Key客户端",
    "description": "登录校验 + 千帆临时 Key 自动签发/轮换 + 积分计费，经 pi-ai 路由注入 dsh。"
