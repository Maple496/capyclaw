{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DSH Deployment Configuration",
  "description": "统一部署配置：描述要部署的 DSH 功能集合、端口、环境和启动参数",
  "type": "object",
  "required": ["name", "version", "deployment"],
  "properties": {
    "name": {
      "type": "string",
      "description": "部署名称（用于生成 runtime ID）",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "description": "配置版本号",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "title": {
      "type": "string",
      "description": "部署显示名称"
    },
    "description": {
      "type": "string",
      "description": "部署说明"
    },
    "deployment": {
      "type": "object",
      "description": "部署配置",
      "required": ["type", "source"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["domain", "suite", "custom"],
          "description": "部署类型：domain（领域包）、suite（套件）、custom（自定义组合）"
        },
        "source": {
          "type": "string",
          "description": "源路径：domain 目录 / suite 目录 / 组件清单文件"
        },
        "storeRoot": {
          "type": "string",
          "description": "存储根目录，默认 ~/.dsh-store"
        },
        "autoStart": {
          "type": "boolean",
          "default": true,
          "description": "创建后自动启动"
        },
        "autoRestart": {
          "type": "boolean",
          "default": false,
          "description": "进程退出后自动重启"
        }
      }
    },
    "runtime": {
      "type": "object",
      "description": "运行时配置（可覆盖 domain 的默认值）",
      "properties": {
        "driver": {
          "type": "string",
          "enum": ["node", "jobobject", "docker", "wsl"],
          "default": "node",
          "description": "隔离驱动"
        },
        "workId": {
          "type": "string",
          "default": "main",
          "description": "工作区 ID"
        },
        "ports": {
          "type": "object",
          "description": "端口配置",
          "properties": {
            "harness": {
              "oneOf": [
                { "type": "integer", "minimum": 1024, "maximum": 65535 },
                {
                  "type": "object",
                  "properties": {
                    "preferred": { "type": "integer" },
                    "range": { "type": "integer", "default": 100 }
                  }
                }
              ]
            },
            "content": {
              "oneOf": [
                { "type": "integer", "minimum": 1024, "maximum": 65535 },
                {
                  "type": "object",
                  "properties": {
                    "preferred": { "type": "integer" },
                    "range": { "type": "integer", "default": 100 }
                  }
                }
              ]
            }
          }
        },
        "model": {
          "type": "object",
          "description": "模型配置",
          "properties": {
            "id": { "type": "string" },
            "plugin": { "type": "string" },
            "apiKeyEnv": { "type": "string" },
            "baseURL": { "type": "string" }
          }
        },
        "env": {
          "type": "object",
          "description": "环境变量",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "launcher": {
      "type": "object",
      "description": "启动器配置",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["foreground", "background", "service"],
          "default": "background",
          "description": "启动模式：foreground（前台）、background（后台）、service（服务）"
        },
        "logFile": {
          "type": "string",
          "description": "日志文件路径（相对于 storeRoot/runtimes/<id>/logs）"
        },
        "pidFile": {
          "type": "string",
          "description": "PID 文件路径"
        },
        "healthCheck": {
          "type": "object",
          "description": "健康检查配置",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "interval": { "type": "integer", "default": 30, "description": "检查间隔（秒）" },
            "timeout": { "type": "integer", "default": 10, "description": "超时（秒）" },
            "retries": { "type": "integer", "default": 3, "description": "失败重试次数" }
          }
        },
        "beforeStart": {
          "type": "array",
          "description": "启动前执行的命令",
          "items": { "type": "string" }
        },
        "afterStart": {
          "type": "array",
          "description": "启动后执行的命令",
          "items": { "type": "string" }
        },
        "beforeStop": {
          "type": "array",
          "description": "停止前执行的命令",
          "items": { "type": "string" }
        },
        "afterStop": {
          "type": "array",
          "description": "停止后执行的命令",
          "items": { "type": "string" }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "description": "监控配置",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "metricsPort": { "type": "integer" },
        "alerts": {
          "type": "object",
          "properties": {
            "cpuThreshold": { "type": "number", "default": 80 },
            "memoryThreshold": { "type": "number", "default": 80 },
            "diskThreshold": { "type": "number", "default": 90 }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "元数据（用于管理和追踪）",
      "properties": {
        "owner": { "type": "string" },
        "environment": { 
          "type": "string",
          "enum": ["development", "staging", "production"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
