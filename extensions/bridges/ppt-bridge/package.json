{
  "name": "ppt-bridge-middleware",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Keynote/PPTist 工作台中间件：桥契约、studio 核心逻辑、MCP 工具服务、插件包构建与 skill 源",
  "scripts": {
    "build": "node scripts/build-works.mjs",
    "check": "node scripts/build-works.mjs --check",
    "test": "node scripts/run-tests.mjs",
    "install:dsh": "node scripts/install-dsh.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check:plugin": "node scripts/build-plugin.mjs --check",
    "test:plugin": "node --test test/plugin.test.mjs",
    "test:packages": "node --test test/skills.test.mjs test/packages.test.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "suite:validate": "node ../../packages/dsh-suite-kit/bin/dsh-suite.mjs validate plugin/dsh-ppt-suite",
    "suite:compose": "node ../../packages/dsh-suite-kit/bin/dsh-suite.mjs compose plugin/dsh-ppt-suite --out dist/suite",
    "suite:doctor": "node ../../packages/dsh-suite-kit/bin/dsh-suite.mjs doctor --profile web",
    "domain:validate": "node ../../packages/dsh-suite-kit/bin/dsh-domain.mjs validate domains/ppt",
    "domain:stage": "node ../../packages/dsh-suite-kit/bin/dsh-domain.mjs stage domains/ppt --out dist/domain-ppt",
    "domain:install": "node ../../packages/dsh-suite-kit/bin/dsh-domain.mjs install domains/ppt --profile domain-ppt",
    "test:e2e": "node scripts/e2e-mcp.mjs",
    "test:e2e:pptx": "node scripts/e2e-pptx.mjs",
    "open:pptx": "node scripts/pptx-open.mjs",
    "install:open-with": "powershell -ExecutionPolicy Bypass -File scripts/install-open-with.ps1",
    "uninstall:open-with": "powershell -ExecutionPolicy Bypass -File scripts/install-open-with.ps1 -Unregister",
    "test:stress": "node scripts/stress-mcp.mjs",
    "bench:modules": "node bench/module-baseline.mjs",
    "evolve": "node bench/evolution/cli.mjs --module all --generations 4 --population 10 --seed 2026",
    "evolve:relay": "node bench/evolution/cli.mjs --module relay --generations 4 --population 10 --seed 2026",
    "evolve:store": "node bench/evolution/cli.mjs --module store --generations 4 --population 10 --seed 2026",
    "evolve:openevolve": ".\\.tools\\openevolve-venv\\Scripts\\openevolve-run.exe bench/openevolve/seed.py bench/openevolve/evaluator.py --config bench/openevolve/config.yaml --iterations 12 --output bench/openevolve/runs/openevolve-final",
    "evolve:google": ".\\.tools\\openevolve-venv\\Scripts\\python.exe bench/google-alpha-evolve/run_local_harness.py",
    "acceptance": "node scripts/acceptance-check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0"
  }
}
