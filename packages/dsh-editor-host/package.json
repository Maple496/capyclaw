{
  "name": "@capyclaw/editor-host",
  "version": "0.1.0",
  "description": "DSH 公共编辑器宿主插件：静态托管、租约仲裁、心跳与连接状态，向插件提供 ctx.editorHost。",
  "type": "module",
  "main": "./lib/host.mjs",
  "exports": {
    ".": "./lib/host.mjs",
    "./src": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "suite": "./dsh-suite.json",
    "apiVersion": "1.0.0"
  },
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml",
    "dsh-suite.json",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/unit.test.mjs"
  },
  "dependencies": {
    "@capyclaw/plugin-kit": "^0.2.0"
  }
}
