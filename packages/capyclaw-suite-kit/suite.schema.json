{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/schemas/suite.schema.json",
  "title": "DSH Suite Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "packages", "rows"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "components": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "引用其他 suite 目录（相对本 suite 目录）；加载时展开其 packages/rows/checks。"
    },
    "packages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "version"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["runtime", "skills", "provider", "ui", "bridge", "support"]
          },
          "version": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "requires": {
            "type": "object",
            "properties": {
              "capabilities": {
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "provides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tools": { "type": "array", "items": { "type": "string" } },
              "skills": { "type": "array", "items": { "type": "string" } },
              "services": { "type": "array", "items": { "type": "string" } },
              "ports": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
              "capabilities": {
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "disabled": { "type": "boolean" },
          "config": { "type": "object" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "url"],
            "properties": {
              "id": { "type": "string" },
              "type": { "const": "http" },
              "url": { "type": "string", "format": "uri" },
              "method": { "type": "string" },
              "expectStatus": { "type": "integer" },
              "expectBody": { "type": "object" },
              "timeoutMs": { "type": "integer", "minimum": 100 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "url", "tool", "major"],
            "properties": {
              "id": { "type": "string" },
              "type": { "const": "contract" },
              "url": { "type": "string", "format": "uri" },
              "tool": { "type": "string" },
              "major": { "type": "integer", "minimum": 0 },
              "timeoutMs": { "type": "integer", "minimum": 100 }
            }
          }
        ]
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
